# Machine-specific settings of the VM helpers (ops/vmctl.sh, vmssh.sh,
# vm_recover.sh). Copy to ops/vm.env (gitignored) and edit. Every value has
# a default in the scripts; only the ones that differ need to be set.
#
# The VM's current external IP lives in ops/vm_ip (written by vm_recover.sh).
# SSH goes through whatever ~/.ssh/config says for the host (a SOCKS proxy
# via ProxyCommand, for instance); the scripts add no proxy of their own.

GCP_PROJECT=my-gcp-project          # project of the VM (Compute API via ADC)
GCP_ZONE=us-central1-a
VM_NAME=chia-alu-vm                 # Compute Engine instance name
VM_SSH_USER=user                    # login user on the VM
VM_SSH_KEY=$HOME/.ssh/id_rsa        # private key for that user
VM_SSH_PORT=22
VM_REPO_DIR='~/chiALU'              # checkout on the VM (quoted: expanded there)
VM_CONDA_SH='~/miniconda3/etc/profile.d/conda.sh'   # conda init script on the VM
VM_CONDA_ENV=chia_env               # conda env with chia, ray and the loop deps
GITHUB_REPO=owner/chiALU            # for the deploy key (vm_recover.sh)
GCLOUD=gcloud                       # gcloud binary on this machine

# The LAN EDA host of ops/hostctl.sh (no VM, no container): ssh target
# (its address is THIS_MACHINE for the run files), the checkout and the
# two bare repositories there, its conda env, its tool directories.
HOST_SSH=host@<IP>
HOST_IP=<IP>
HOST_REPO_DIR=~/chiALU
HOST_BARE_DIR=~/chiALU.git
HOST_ADIR_BARE_DIR=~/adir.git
HOST_CONDA_DIR=~/miniconda3
HOST_CONDA_ENV=chia_env
HOST_TOOLS='$HOME/tools/bin:$HOME/tools/oss-cad-suite/bin:$HOME/.local/bin'
