# ADIR-DECL v1
# VAR abc.script_family=custom
# ADIR-END
# The tool's default: yosys synth without ABC, then one ABC mapping
# pass under the delay target.
read_verilog -sv {rtl}
hierarchy -check -top {top}
synth -top {top} -flatten -noabc -noshare
abc -liberty {liberty} -script +strash;&get,-n;&nf,-D,{clock_ps};&put;topo;stime
