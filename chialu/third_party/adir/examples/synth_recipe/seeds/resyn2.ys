# ADIR-DECL v1
# VAR abc.script_family=resyn2
# ADIR-END
# resyn2 before mapping: two rounds of balance / rewrite / refactor.
read_verilog -sv {rtl}
hierarchy -check -top {top}
synth -top {top} -flatten -noabc -noshare
abc -liberty {liberty} -script +strash;balance;rewrite;refactor;balance;rewrite;rewrite,-z;balance;refactor,-z;rewrite,-z;balance;&get,-n;&nf,-D,{clock_ps};&put;topo;stime
